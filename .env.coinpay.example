# Append to Vicoa's .env. Everything else stays as documented in SELF_HOSTING.md.

# Merchant API key for the business (cp_live_… / cp_test_…). The OAuth client
# id also starts with cp_ and cannot create payments.
COINPAY_API_KEY=cp_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
COINPAY_BUSINESS_ID=00000000-0000-0000-0000-000000000000
# Plaintext webhook secret: GET /api/businesses/:id/webhook-secret, or the dashboard.
COINPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Defaults shown.
# COINPAY_BASE_URL=https://coinpayportal.com
# COINPAY_BLOCKCHAINS=USDC_BASE,USDC_POL,USDC_ETH,ETH,BTC,SOL
# COINPAY_PRO_MONTHLY_USD=12
# COINPAY_PRO_ANNUAL_USD=108
# COINPAY_MONTHLY_DAYS=30
# COINPAY_ANNUAL_DAYS=365
# COINPAY_FREE_MESSAGE_LIMIT=20      # per calendar month; 0 turns the gate off
# COINPAY_FREE_AGENT_LIMIT=10        # display only, mirrors Vicoa's free tier
# COINPAY_SWEEP_INTERVAL=60          # seconds
# COINPAY_CHECKOUT_SECRET=           # defaults to the webhook secret
